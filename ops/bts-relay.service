# systemd-Unit für den bts-relay-Cloud-Relay.
#
# Installation auf dem Hetzner-Server (einmalig): siehe docs/cloud-relay.md.
#
# WICHTIG: Der Dienst laeuft als eigener Benutzer bts-relay, NICHT als badhub.
# Grund: badhub hat NOPASSWD:ALL. Liefe der Dienst als badhub, waere jeder, der
# die Binary austauschen und den Dienst neu starten darf — also der Deploy —
# mit zwei erlaubten Schritten root. Mit bts-relay laeuft eingeschleuster Code
# als unprivilegierter Benutzer. Am 2026-08-12 real gegengeprueft.

[Unit]
Description=bts-relay - Cloud-Relay fuer den BTS-Light-Tablet-Spielzettel
After=network.target

[Service]
Type=simple
User=bts-relay
# Port, auf dem nginx den Relay erreicht (siehe nginx-bts-relay.conf).
Environment=PORT=8090
# Oeffentliche Basis-URL fuer die QR-Codes.
Environment=PUBLIC_BASE=https://badhub.de/bts-relay
# Verzeichnis fuer die taeglich rotierende Relay-Logdatei (bts-relay.log.YYYY-MM-DD).
# Liegt unter storage/, damit der Betrieb ohne journalctl-Recht mitlesen kann.
# Das Verzeichnis gehoert badhub:bts-relay und traegt das setgid-Bit (2775) —
# ohne setgid koennte der Dienst die Logdatei des naechsten Tages nicht anlegen.
# Ohne diese Var: nur stdout (journald). Nach Aenderung dieser Unit einmalig:
# sudo systemctl daemon-reload.
Environment=RELAY_LOG_DIR=/var/www/badhub/storage/relay-logs
ExecStart=/opt/bts-relay/bts-relay
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
